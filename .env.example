# Copie para .env.local e ajuste. Nunca coloque chave, token ou senha aqui.

# true = mostra as marcas TODO-CONFIRMAR e as seções que dependem de confirmação do dono.
VITE_PROPOSAL_MODE=false

# Só preencha depois que o dono confirmar o número. Formato: 55 + DDD + número, só dígitos.
VITE_WHATSAPP_NUMBER=

# Endereço público do site (ex.: https://impacto.vercel.app). Usado para og:image e og:url absolutos.
VITE_SITE_URL=
